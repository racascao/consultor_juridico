# Configuração do Consultor Jurídico
ENV=development
DEBUG=true

# PostgreSQL + pgvector
POSTGRES_USER=consultor
POSTGRES_PASSWORD=consultor_pass
POSTGRES_DB=consultor_juridico_v02
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://consultor:consultor_pass@db:5432/consultor_juridico_v02

# Aquisição documental HTTP
INGESTION_CONNECT_TIMEOUT=10
INGESTION_READ_TIMEOUT=30
INGESTION_WRITE_TIMEOUT=10
INGESTION_POOL_TIMEOUT=10
INGESTION_MAX_ATTEMPTS=3
INGESTION_BACKOFF_SECONDS=0.5
INGESTION_RETRY_AFTER_MAX_SECONDS=5
INGESTION_MIN_BYTES=1024
INGESTION_MAX_BYTES=10485760
PLANALTO_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/151 Safari/537.36
