# Configuração do Consultor Jurídico
ENV=development
DEBUG=true

# PostgreSQL + pgvector
POSTGRES_USER=consultor
POSTGRES_PASSWORD=consultor_pass
POSTGRES_DB=consultor_juridico
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://consultor:consultor_pass@db:5432/consultor_juridico

# Ollama LLM Runtime
# Modelos locais: Fase 9.3 adotou granite4.1:3b para geração e juiz
# (reduz false abstention de 8/10→2/10 em real-world, hit 0.8, unsafe 0).
# Altere SEMANTIC_JUDGE_MODEL para outro modelo se desejar comparar; vazio = fallback para OLLAMA_MODEL.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=granite4.1:3b
SEMANTIC_JUDGE_MODEL=granite4.1:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=120
EMBEDDING_BATCH_SIZE=32
CONSULTATION_TIMEOUT=180
CONSULTATION_MAX_TOKENS=800
CONSULTATION_TOP_K=10
CONSULTATION_MAX_ATTEMPTS=2
CONSULTATION_EVIDENCE_LIMIT=3

# Aquisição documental HTTP
INGESTION_CONNECT_TIMEOUT=10
INGESTION_READ_TIMEOUT=30
INGESTION_WRITE_TIMEOUT=10
INGESTION_POOL_TIMEOUT=10
INGESTION_MAX_ATTEMPTS=3
INGESTION_BACKOFF_SECONDS=0.5
INGESTION_RETRY_AFTER_MAX_SECONDS=5
INGESTION_MIN_BYTES=1024
INGESTION_MAX_BYTES=10485760
PLANALTO_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/151 Safari/537.36
